# Copie este arquivo para ".env" e preencha com as strings de conexão reais.
# No Supabase: Project Settings → Database → Connect → aba "ORM" → Prisma.
# O .env de verdade NUNCA deve ser commitado — o .gitignore já cuida disso.

# Conexão via pooler (porta 6543) — o app usa essa no dia a dia
DATABASE_URL="postgresql://usuario:senha@host:6543/postgres?pgbouncer=true"

# Conexão direta (porta 5432) — só o Prisma Migrate usa
DIRECT_URL="postgresql://usuario:senha@host:5432/postgres"

# Chave usada para assinar os tokens de login (JWT). Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-uma-chave-aleatoria-bem-grande"

# Porta em que a API vai escutar (opcional, padrão 3333)
PORT=3333
