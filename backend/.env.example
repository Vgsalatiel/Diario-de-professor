# Copie este arquivo para ".env" e preencha com as strings de conexão reais.
# No Supabase: Project Settings → Database → Connect → aba "ORM" → Prisma.
# O .env de verdade NUNCA deve ser commitado — o .gitignore já cuida disso.

# Conexão via pooler (porta 6543) — o app usa essa no dia a dia
DATABASE_URL="postgresql://usuario:senha@host:6543/postgres?pgbouncer=true"

# Conexão direta (porta 5432) — só o Prisma Migrate usa
DIRECT_URL="postgresql://usuario:senha@host:5432/postgres"

# Chave usada para assinar os tokens de login (JWT). Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-uma-chave-aleatoria-bem-grande"

# Porta em que a API vai escutar (opcional, padrão 3333)
PORT=3333

# URL(s) do frontend que podem chamar essa API (CORS). Em produção, defina
# com a URL real do Netlify — sem essa variável, a API libera qualquer origem
# (bom só em desenvolvimento local). Pode listar mais de uma, separada por vírgula.
FRONTEND_URL="https://gestao-professor.netlify.app"

# Chave da API do Resend (resend.com), usada pra enviar o e-mail de "esqueci
# minha senha". Sem essa variável, o link só aparece no log do servidor —
# útil pra testar local, mas em produção precisa estar configurada de verdade.
RESEND_API_KEY="re_sua_chave_aqui"

# Remetente do e-mail de redefinição de senha. Enquanto o domínio do Resend
# não estiver verificado, use o domínio de teste deles (só envia pro seu
# próprio e-mail cadastrado na conta Resend).
EMAIL_FROM="Diário <onboarding@resend.dev>"

# Chave da API do Gemini (aistudio.google.com/apikey), usada pra gerar
# exercícios personalizados por aluno no Assistente IA. Sem essa variável,
# o endpoint de geração responde com erro em vez de gerar.
GEMINI_API_KEY="sua_chave_aqui"

# Modelo do Gemini usado na geração (opcional, padrão "gemini-3.5-flash-lite").
# O "flash-lite" tem cota gratuita bem maior que os modelos "flash" cheios
# (por volta de 500 gerações/dia contra ~20/dia, em set/2026) — o Google muda
# esses números com frequência, vale conferir em ai.google.dev/gemini-api/docs/rate-limits.
GEMINI_MODEL="gemini-3.5-flash-lite"
