// Schema do banco de dados do Diário — espelha os tipos de
// /src/types.ts do frontend, agora como tabelas relacionais de verdade.
// Cada Turma pertence a um Professor (via professorId), e tudo o mais
// (Aluno, Avaliacao, Evento, DataAula...) pertence a uma Turma — é essa
// cadeia de relações que isola os dados de cada professor no banco,
// no lugar do prefixo de chave que o app usa hoje no localStorage.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Conexão via pooler (pgbouncer) — usada pelo app no dia a dia
  url       = env("DATABASE_URL")
  // Conexão direta — só o Prisma Migrate usa, pra criar/alterar tabelas
  directUrl = env("DIRECT_URL")
}

model Professor {
  id      String  @id @default(cuid())
  nome    String
  email   String  @unique
  senha    String // hash da senha — nunca texto puro
  materias String[] // um professor pode dar aula de mais de uma matéria
  fotoUrl  String?

  // Conta de diretor(a) — entra pelo mesmo login, mas cai no painel de
  // administração em vez do painel de professor. Só concedido manualmente.
  isAdmin Boolean @default(false)

  // Conta de coordenação pedagógica — acompanha professores/turmas (aulas,
  // frequência, avaliações, planejamento, dificuldades) e organiza reuniões
  // e observações, mas não administra contas/turmas como o(a) diretor(a).
  // Também só concedido manualmente.
  isCoordenador Boolean @default(false)

  // Recuperação de senha: guardamos o hash do token (nunca o token em si)
  // e a validade — um link de redefinição vale por 1 hora e uso único.
  resetSenhaTokenHash String?
  resetSenhaExpiraEm  DateTime?

  // Verificação de e-mail: mesmo esquema do reset de senha, mas não
  // bloqueia o uso do sistema — só mostra um aviso até confirmar.
  emailVerificado          Boolean   @default(false)
  verificacaoTokenHash     String?
  verificacaoExpiraEm      DateTime?

  criadoEm DateTime @default(now())

  turmas   Turma[]
  eventos  Evento[]
  feriados Feriado[]

  // Observações pedagógicas — as que essa conta escreveu (coordenação) e,
  // se for professor, as que recebeu sobre o próprio trabalho.
  observacoesEscritas  ObservacaoPedagogica[] @relation("ObservacoesEscritas")
  observacoesRecebidas ObservacaoPedagogica[] @relation("ObservacoesRecebidas")

  @@map("professores")
}

// A coordenação acompanha o trabalho do professor, mas isso não significa
// que ela pode alterar o que ele fez — o modelo aqui é "visualizar →
// comentar → solicitar correção", nunca editar direto. "comentario" é só
// uma nota; "solicitacaoCorrecao" é um pedido concreto de ajuste (ex.:
// "registre a aula que falta") que o professor pode marcar como resolvido.
enum TipoObservacao {
  comentario
  solicitacaoCorrecao
}

// Nota (ou pedido de correção) da coordenação pedagógica sobre o trabalho
// de um professor — opcionalmente amarrada a uma turma específica. Só a
// coordenação escreve; o professor-alvo lê e, se for solicitação, marca
// como resolvida quando atender.
model ObservacaoPedagogica {
  id       String          @id @default(cuid())
  texto    String
  tipo     TipoObservacao  @default(comentario)
  resolvida Boolean        @default(false)
  criadoEm DateTime @default(now())

  autorId String
  autor   Professor @relation("ObservacoesEscritas", fields: [autorId], references: [id], onDelete: Cascade)

  professorAlvoId String
  professorAlvo   Professor @relation("ObservacoesRecebidas", fields: [professorAlvoId], references: [id], onDelete: Cascade)

  turmaId String?
  turma   Turma? @relation(fields: [turmaId], references: [id], onDelete: SetNull)

  @@index([professorAlvoId])
  @@index([autorId])
  @@map("observacoes_pedagogicas")
}

// Dia sem aula pra todas as turmas do professor — feriado, recesso, ponto
// facultativo etc. Marcado na Agenda, vale pra escola inteira (todas as
// turmas daquele professor/diretor), diferente do "sem aula" da tela de
// Frequência, que é só pra uma turma numa data específica.
model Feriado {
  id     String @id @default(cuid())
  data   DateTime @db.Date
  titulo String

  professorId String
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  @@unique([professorId, data])
  @@index([professorId])
  @@map("feriados")
}

enum SistemaPeriodo {
  bimestre
  trimestre
  semestre
}

// Turno em que a turma acontece — separa a visão da coordenação/diretoria
// por manhã/tarde/noite, já que a mesma escola pode repetir "9º Ano A" em
// turnos diferentes com professores diferentes.
enum Turno {
  manha
  tarde
  noite
}

// Etapa de ensino no sentido da BNCC — controla que habilidades aparecem
// pro Assistente de planejamento contextual. Só cobrimos Fundamental e
// Médio por enquanto: a Educação Infantil é organizada por campos de
// experiência (não por componente+ano), então não encaixa no mesmo picker.
enum EtapaBncc {
  fundamental
  medio
}

model Turma {
  id             String         @id @default(cuid())
  nome           String // ex.: "9º Ano A"
  serie          String // ex.: "Ensino Fundamental II"
  anoLetivo      String // ex.: "2026"
  escola         String // nome da escola — professor pode ter turmas em mais de uma
  sistemaPeriodo SistemaPeriodo
  cor            String
  diasAula       Int[] // dias da semana com aula: 0=domingo .. 6=sábado

  // Opcional pra não quebrar turma já cadastrada antes desse campo existir.
  turno Turno?

  // Componente curricular fixo dessa turma (ex.: "Matemática") — usado pra
  // já vir preenchido no plano de aula e pra filtrar as habilidades BNCC
  // do Assistente de planejamento contextual.
  disciplina String?

  // Etapa + ano/série no vocabulário da BNCC — sem isso não dá pra saber
  // com segurança quais habilidades (EF05MA.. vs EM13MAT..) valem pra essa
  // turma. Opcionais pra não quebrar turmas já cadastradas.
  etapaBncc     EtapaBncc?
  anoSerieBncc  Int? // 1-9 no Fundamental, 1-3 no Médio

  professorId String
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  // Soft delete: "excluir" turma só marca essa data — os dados continuam no
  // banco, só somem das telas. Sem isso, apagar por engano perde tudo (alunos,
  // notas, frequência...) sem chance de recuperar.
  excluidoEm DateTime?

  alunos        Aluno[]
  avaliacoes    Avaliacao[]
  datasAula     DataAula[]
  eventos       Evento[]
  config        ConfigCalculo?
  planosDeAula  PlanoDeAula[]
  registrosAula RegistroAula[]
  observacoes   ObservacaoPedagogica[]

  @@index([professorId])
  @@map("turmas")
}

enum SituacaoMatricula {
  ativo
  inativo
  transferido
}

model Aluno {
  id             String            @id @default(cuid())
  nome           String
  email          String?
  telefonePais   String?
  matricula      String?
  dataNascimento DateTime?
  situacao       SituacaoMatricula @default(ativo)

  // Observação pedagógica livre — dificuldades/facilidades do aluno,
  // usada como contexto pro Assistente IA gerar exercícios sob medida.
  dificuldades String?

  turmaId String
  turma   Turma  @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  // Soft delete: mesma lógica da turma — excluir só marca a data.
  excluidoEm DateTime?

  notas              Nota[]
  frequencias        Frequencia[]
  exerciciosGerados  ExercicioGerado[]
  entregas           Entrega[]

  @@index([turmaId])
  @@map("alunos")
}

// Lista de exercícios que o Assistente IA gerou pra um aluno específico —
// guardada pra o professor poder consultar depois, sem depender de ter
// baixado o PDF na hora.
model ExercicioGerado {
  id          String    @id @default(cuid())
  titulo      String
  assunto     String
  dificuldade String?
  questoes    Json // array de { enunciado, gabarito }
  criadoEm    DateTime  @default(now())

  // Opcional — quando esse exercício é preparo pra uma prova específica,
  // o professor pode anotar o nome dela e o dia em que será aplicada.
  nomeProva String?
  dataProva DateTime? @db.Date

  alunoId String
  aluno   Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@index([alunoId])
  @@map("exercicios_gerados")
}

model Avaliacao {
  id      String @id @default(cuid())
  nome    String // ex.: "Prova 1", "Trabalho"
  peso    Float  @default(1)
  periodo String // "1".."4" — bimestre/trimestre/semestre, depende da turma

  turmaId String
  turma   Turma  @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  notas Nota[]

  @@index([turmaId])
  @@map("avaliacoes")
}

// Uma nota lançada de um aluno numa avaliação (substitui o "MapaDeNotas"
// em formato de string do frontend por uma linha de verdade na tabela).
model Nota {
  id    String @id @default(cuid())
  valor Float? // usado quando a turma trabalha com nota numérica (0-10)

  // Usado quando a turma trabalha com conceito em vez de nota — turmas
  // desse tipo nunca usam "valor" (ver ConfigCalculo.tipoAvaliacao).
  conceito String?

  alunoId     String
  aluno       Aluno     @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  avaliacaoId String
  avaliacao   Avaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)

  @@unique([alunoId, avaliacaoId])
  @@map("notas")
}

// Uma data de chamada dentro de uma turma — cada uma vira uma "coluna"
// de frequência. semAula marca um dia que não conta pra ninguém.
model DataAula {
  id      String   @id @default(cuid())
  data    DateTime @db.Date
  periodo String
  semAula Boolean  @default(false)

  turmaId String
  turma   Turma  @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  frequencias Frequencia[]

  @@unique([turmaId, data])
  @@map("datas_aula")
}

// presente = true (presença), false (falta), null (ainda não lançado)
model Frequencia {
  id       String   @id @default(cuid())
  presente Boolean?

  alunoId    String
  aluno      Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  dataAulaId String
  dataAula   DataAula @relation(fields: [dataAulaId], references: [id], onDelete: Cascade)

  @@unique([alunoId, dataAulaId])
  @@map("frequencias")
}

enum ModeloCalculo {
  simples
  ponderada
}

// Nota numérica (0-10, com média calculada) ou conceito (texto livre tipo
// "Ótimo"/"Bom"/"Regular"/"Insuficiente", sem média — cada turma escolhe
// um dos dois, nunca mistura.
enum TipoAvaliacao {
  nota
  conceito
}

model ConfigCalculo {
  id             String        @id @default(cuid())
  modelo         ModeloCalculo @default(simples)
  mediaAprovacao Float         @default(6)
  tipoAvaliacao  TipoAvaliacao @default(nota)

  turmaId String @unique
  turma   Turma  @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@map("configs_calculo")
}

enum TipoEvento {
  prova
  trabalho
  reuniao
  outro
}

model Evento {
  id        String     @id @default(cuid())
  titulo    String
  tipo      TipoEvento
  data      DateTime   @db.Date
  hora      String?
  conteudo  String?
  concluido Boolean    @default(false)
  // Prazo de entrega — usado por eventos do tipo "trabalho"/atividade
  // criados de dentro de um plano de aula.
  prazo     DateTime?  @db.Date

  // Todo evento pertence a um professor — a turma é opcional (evento avulso,
  // ex.: reunião pedagógica), mas sem isso um evento sem turma ficaria sem dono.
  professorId String
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)

  turmaId String?
  turma   Turma?  @relation(fields: [turmaId], references: [id], onDelete: SetNull)

  // Quando o evento é uma prova criada de dentro de um plano de aula.
  planoId String?
  plano   PlanoDeAula? @relation(fields: [planoId], references: [id], onDelete: SetNull)

  entregas Entrega[]

  @@index([professorId])
  @@index([turmaId])
  @@index([planoId])
  @@map("eventos")
}

// Status de entrega de uma prova/atividade (Evento) por aluno — o professor
// marca individualmente quem fez, quem ainda não entregou etc.
enum StatusEntrega {
  pendente
  feito
  naoEntregou
}

model Entrega {
  id     String        @id @default(cuid())
  status StatusEntrega @default(pendente)

  alunoId String
  aluno   Aluno   @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  eventoId String
  evento   Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@unique([alunoId, eventoId])
  @@map("entregas")
}

// Duração que o professor escolhe pro plano: quinzenal, semestral ou uma
// data personalizada — em todos os casos ele decide o "até quando" no fim.
enum DuracaoPlano {
  quinzenal
  semestral
  personalizado
}

model PlanoDeAula {
  id         String       @id @default(cuid())
  titulo     String
  duracao    DuracaoPlano
  dataInicio DateTime     @db.Date
  dataFim    DateTime     @db.Date
  conteudo   String?
  criadoEm   DateTime     @default(now())

  // Cronograma gerado pelo Assistente de planejamento contextual: um
  // array de { numero, data, habilidadeCodigo, habilidadeTexto, subtema,
  // resumo } — uma aula planejada por item, cobrindo o período inteiro do
  // plano (não só uma aula avulsa). Cada habilidadeCodigo sempre vem
  // validado contra a base real da BNCC antes de salvar, nunca inventado
  // pela IA. Null quando o plano foi criado sem o assistente.
  cronograma Json?

  turmaId String
  turma   Turma  @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  provas    Evento[]
  registros RegistroAula[]

  @@index([turmaId])
  @@map("planos_de_aula")
}

// "O que foi aplicado no dia" — um resumo por turma/data, mostrado no
// botão "Aula deste dia" da tela de Frequência.
model RegistroAula {
  id     String   @id @default(cuid())
  data   DateTime @db.Date
  resumo String

  turmaId String
  turma   Turma  @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  planoId String?
  plano   PlanoDeAula? @relation(fields: [planoId], references: [id], onDelete: SetNull)

  // Quando o professor confirma que esse dia corresponde a um item do
  // cronograma do plano (sugestão pré-marcada pela data, mas sempre
  // confirmada por ele antes de salvar — nunca automático). bnccCodigo/
  // bnccTexto são uma cópia do item no momento da confirmação, pra manter
  // o histórico mesmo que o cronograma do plano mude depois.
  planoItemNumero Int?
  bnccCodigo      String?
  bnccTexto       String?

  @@unique([turmaId, data])
  @@index([turmaId])
  @@index([planoId])
  @@map("registros_aula")
}
